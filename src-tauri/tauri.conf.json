{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Consola",
  "version": "1.1.0",
  "identifier": "es.consola.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CouchDesk",
        "width": 1600,
        "height": 900,
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#F3ECE1",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/appcache/librarycache/**", "**/Consola/iconos/**", "**/Consola/webs/**", "**/Consola/fondos/**", "**/Consola/musica/**", "**/Consola/temas/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Consola",
    "shortDescription": "Consola",
    "longDescription": "Escritorio tipo consola para Windows, manejable con mando",
    "copyright": "Consola",
    "category": "Game",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["Spanish"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
