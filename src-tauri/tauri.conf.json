{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CouchDesk",
  "mainBinaryName": "couchdesk",
  "version": "1.2.0",
  "identifier": "es.consola.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CouchDesk",
        "width": 1600,
        "height": 900,
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#F3ECE1",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/appcache/librarycache/**", "**/Consola/iconos/**", "**/Consola/webs/**", "**/Consola/fondos/**", "**/Consola/musica/**", "**/Consola/temas/**", "**/CouchDesk/iconos/**", "**/CouchDesk/webs/**", "**/CouchDesk/fondos/**", "**/CouchDesk/musica/**", "**/CouchDesk/temas/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CouchDesk",
    "homepage": "https://pablonolascoo.github.io/couchdesk/",
    "shortDescription": "CouchDesk",
    "longDescription": "Tu PC con Windows en modo consola: juegos, nube, emuladores y webs con el mando, el teclado o el móvil.",
    "copyright": "© 2026 Pablo Nolasco · MIT",
    "category": "Game",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "../brand/installer/header.bmp",
        "sidebarImage": "../brand/installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish", "English", "PortugueseBR", "French", "German", "Italian"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
